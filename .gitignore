.output/
build/
.cache/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# GSD Core -- installed per machine, never committed.
# The installer writes machine-absolute paths into every agent and command file,
# so a vendored copy is only ever correct on the machine that generated it. The
# copy previously committed here pointed at /home/user/claude_template and was
# broken for everyone. Setup runs: bash scripts/ensure-gsd.sh
# Both command layouts are ignored. GSD 1.13.x writes .claude/commands/gsd-*.md flat;
# earlier versions wrote .claude/commands/gsd/*.md. Ignoring only the nested form left
# about seventy untracked command files in git status after every install.
.claude/gsd-core/
.claude/agents/*
.claude/commands/gsd/
.claude/commands/gsd-*.md
.claude/commands/settings.local.json
.claude/hooks/
.claude/scripts/
.claude/gsd-file-manifest.json
.claude/gsd-install-state.json
.claude/gsd-migration-journal/
.claude/package.json
.claude/.gsd-profile
.claude/.gsd-staging/
.claude/settings.local.json
gsd-local-patches/

# Claude Code -- DO NOT ignore .agents/skills/ or skills-lock.json
# Both must be committed so any machine or container gets the same vendored skills.
# .agents/skills/   <-- intentionally NOT ignored
# skills-lock.json  <-- intentionally NOT ignored

# .claude/agents/* above is blanket-ignored for GSD's machine-absolute-path agents.
# (/* not a trailing / -- git cannot negate a file inside a dir excluded with /.)
# These two are hand-written, portable, no absolute paths -- carve them back in so
# they sync across machines like everything else in this repo.
!.claude/agents/visual-gate-reviewer.md
!.claude/agents/freeze-auditor.md

# Logs
*.log
npm-debug.log*

# Local tooling scratch, never committed
.serena/
.claude/.headroom_wrap_marker.json
*.tsbuildinfo
.playwright-mcp/
